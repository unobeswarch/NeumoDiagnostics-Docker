# ─────────────────────────────────────────────────────────────────────────────
# RDS PostgreSQL (Auth Database)
# ─────────────────────────────────────────────────────────────────────────────
TF_VAR_db_password=YOUR_SECURE_DB_PASSWORD

# ─────────────────────────────────────────────────────────────────────────────
# SMTP Configuration (Email Notifications)
# ─────────────────────────────────────────────────────────────────────────────
TF_VAR_smtp_host=smtp.mailgun.org
TF_VAR_smtp_port=587
TF_VAR_smtp_username=postmaster@your-domain.mailgun.org
TF_VAR_smtp_password=YOUR_MAILGUN_API_KEY
TF_VAR_email_from=notification@neumodiagnostics.com

