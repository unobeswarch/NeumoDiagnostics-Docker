    "availability_patterns_summary": {
      "value": {
        "scenario_1_hot_spare": {
          "architecture": "web-frontend → ALB Interno → [api-gateway-1, api-gateway-2, api-gateway-3]\r\nSi una instancia falla, ALB detecta via health check y redistribuye tráfico\r\n",
          "component": "api-gateway",
          "description": "API Gateway con 3+ tareas activas detrás de ALB interno",
          "load_balancer": "ALB Interno: internal-neumo-dev-internal-1987845174.us-east-1.elb.amazonaws.com",
          "tasks": 1
        },
        "scenario_2_service_discovery": {
          "description": "Service Discovery vía AWS Cloud Map",
          "namespace": "neumo.internal",
          "services": [
            "api-gateway",
            "auth-be",
            "message-producer",
            "mongodb",
            "notification-be",
            "prediagnostic-be",
            "rabbitmq"
          ]
        },
        "scenario_3_cluster": {
          "component": "prediagnostic-be",
          "description": "Cluster Pattern con N+1 redundancia",
          "max_tasks": 4,
          "min_tasks": 2,
          "tasks": 2
        },
        "scenario_4_warm_spare": {
          "component": "auth-db (RDS PostgreSQL)",
          "description": "Database Failover con RDS Multi-AZ",
          "endpoint": "neumo-dev-auth-db.cgl0ou8kgi9a.us-east-1.rds.amazonaws.com:5432",
          "multi_az": false
        }
      },
